//use prisma-next

model admissionform{
  id Int @id @default(autoincrement())
  name String
  mobilenumber String
  email String
  interestedin String 

  createdAt DateTime @default(now())
} 

model addfeaturednews{
  id Int @id @default(autoincrement())
  image String
  category String
  headline String
  firstparagraph String
  secondparagraph String
}

model News{
  id Int @id @default(autoincrement())
  category String
  image String
  title String
  description String
  date String
  createdAt DateTime @default(now())
}

enum Role{
  ADMIN
  USER
}

model User{
  id Int @id @default(autoincrement())
  username String
  password String
  role Role @default(USER)
  createdAt DateTime @default(now())
}



