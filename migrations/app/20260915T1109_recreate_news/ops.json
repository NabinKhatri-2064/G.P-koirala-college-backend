  {
    "id": "column.public.news.createdAt",
    "label": "Add column \"createdAt\" to \"news\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "createdAt",
        "table": "news"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"createdAt\" is missing",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "news",
          "createdAt"
        ]
      }
    ],
    "execute": [
      {
        "description": "add column \"createdAt\"",
        "sql": "ALTER TABLE \"public\".\"news\" ADD COLUMN \"createdAt\" timestamptz DEFAULT (now()) NOT NULL"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"createdAt\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "news",
          "createdAt"
        ]
      }
    ]
  }
]