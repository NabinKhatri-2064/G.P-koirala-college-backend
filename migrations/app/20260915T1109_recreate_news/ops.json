        "description": "ensure table \"blanket\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"blanket\""
        ]
      }
    ],
    "execute": [
      {
        "description": "drop table \"blanket\"",
        "sql": "DROP TABLE \"public\".\"blanket\""
      }
